    "direction": {
      "name": "Breezeway Courtyard Villa",
      "concept": "A contemporary Caribbean composition organized as a strong, low limestone plinth facing the arrival court, with a lighter, offset upper bedroom bar and a deeply shaded south-facing garden veranda. The asymmetrical entry pavilion and stepped upper volume give the villa a distinct identity from every approach while preserving a broad, calm pool garden.",
      "hierarchy": [
        "Primary mass: broad two-storey central living volume",
        "Secondary mass: lower east bedroom/service wing",
        "Arrival marker: compact west entry pavilion projecting toward the north forecourt",
        "Garden threshold: full-width covered south veranda",
        "Crowning mass: offset upper bedroom bar with a smaller east suite volume"
      ],
      "roofLanguage": "Low, crisply edged Caribbean roof planes with deep overhangs; the upper volumes should read as floating shade canopies above recessed glazing and shaded terraces.",
      "entrance": "Arrival is from the north into a generous forecourt. The projecting west entry pavilion creates a protected, memorable approach before guests turn into a tall, shaded entry recess beneath the offset upper mass.",
      "outdoorLiving": "The south side is the dedicated garden face: a 4.5 m-deep covered veranda extends from the main living mass and forms the shaded transition to the future pool terrace and approximately 9 m-deep swimming pool beyond.",
      "landscape": "Maintain an open north arrival lawn and forecourt, with palms framing the entry pavilion. The south garden is a broad resort-like lawn and palm grove around the pool, with layered tropical planting concentrated along the east and west boundaries.",
      "palette": {
        "walls": "ivory",
        "accent": "limestone",
        "roof": "bronze",
        "roofColor": "#4A4037",
        "deck": "timber"
      }
    },
