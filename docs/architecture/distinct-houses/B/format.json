{
  "type": "json",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "architecturalPlan": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "scaleRationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200,
                "description": "Explain scale in relation to budget, brief and site; justify an unusually compact luxury residence."
              },
              "arrivalAndCirculation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "volumeHierarchy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "relationshipsAndViews": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "roofFacadeAndMaterials": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "intendedSpaces": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "spatialRelationships": {
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subject": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "relation": {
                      "type": "string",
                      "enum": [
                        "adjacent-to",
                        "connected-to",
                        "above",
                        "below",
                        "facing",
                        "set-back-from",
                        "covering",
                        "clear-of",
                        "inside"
                      ]
                    },
                    "clearance": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10000
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "subject",
                    "target",
                    "relation",
                    "clearance",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "designDecisions": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "disposition": {
                      "type": "string",
                      "enum": [
                        "constructed",
                        "guidance",
                        "considered",
                        "unsupported"
                      ]
                    },
                    "knowledgeId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "decision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "elementIds": {
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    },
                    "limitation": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "knowledgeId",
                    "decision",
                    "elementIds",
                    "limitation"
                  ],
                  "additionalProperties": false
                }
              }
