            "required": [
              "scaleRationale",
              "arrivalAndCirculation",
              "volumeHierarchy",
              "relationshipsAndViews",
              "roofFacadeAndMaterials",
              "intendedSpaces"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "scaleRationale": {
                "type": "string",
