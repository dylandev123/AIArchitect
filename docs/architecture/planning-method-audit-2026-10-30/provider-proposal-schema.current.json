{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "spatial-proposal-1"
    },
    "concept": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "alternatives": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "concept",
          "tradeoff"
        ],
        "additionalProperties": false
      }
    },
    "selectionReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "site": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "arrival": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          }
        },
        "viewDirection": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          }
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "assumptions",
        "arrival",
        "viewDirection",
        "organization"
      ],
      "additionalProperties": false
    },
    "anchors": {
      "minItems": 1,
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "floor",
              "enclosure",
              "roof",
              "entrance",
              "circulation",
              "facade",
              "landscape",
              "outdoor"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "plate",
              "wall",
              "roof",
              "glazing",
              "balcony",
              "entrance",
              "screen",
              "sofa",
              "volume",
              "water",
              "pavilion"
            ]
          },
          "centre": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          },
          "size": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            }
          },
          "yaw": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "geometry": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "extrusion"
                      },
                      "axis": {
                        "type": "string",
                        "enum": [
                          "x",
                          "y",
                          "z"
                        ]
                      },
                      "outline": {
                        "minItems": 3,
                        "maxItems": 128,
                        "type": "array",
                        "items": {
                          "minItems": 2,
                          "maxItems": 2,
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": -0.5,
                            "maximum": 0.5
                          }
                        }
                      },
                      "holes": {
                        "anyOf": [
                          {
                            "maxItems": 8,
                            "type": "array",
                            "items": {
                              "minItems": 3,
                              "maxItems": 128,
                              "type": "array",
                              "items": {
                                "minItems": 2,
                                "maxItems": 2,
                                "type": "array",
                                "items": {
                                  "type": "number",
                                  "minimum": -0.5,
                                  "maximum": 0.5
                                }
                              }
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "axis",
                      "outline",
                      "holes"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "arc"
                      },
                      "axis": {
                        "type": "string",
                        "enum": [
                          "x",
                          "y",
                          "z"
                        ]
                      },
                      "start": {
                        "type": "number",
                        "minimum": -6.283185307179586,
                        "maximum": 6.283185307179586
                      },
                      "sweep": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 6.283185307179586
                      },
                      "innerRatio": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 0.999
                      },
                      "segments": {
                        "type": "integer",
                        "minimum": 4,
                        "maximum": 64
                      }
                    },
                    "required": [
                      "type",
                      "axis",
                      "start",
                      "sweep",
                      "innerRatio",
                      "segments"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "material": {
            "type": "string",
            "enum": [
              "ivory",
              "limestone",
              "timber",
              "bronze",
              "sage"
            ]
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "panels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "roofForm": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "flat",
                  "gable",
                  "hip"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "overhang": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "opening": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "sill": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000
                  },
                  "glazed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "x",
                  "sill",
                  "width",
                  "height",
                  "glazed"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "designReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "id",
          "role",
          "kind",
          "centre",
          "size",
          "yaw",
          "geometry",
          "material",
          "color",
          "panels",
          "roofForm",
          "overhang",
          "opening",
          "designReason"
        ],
        "additionalProperties": false
      }
    },
    "spaces": {
      "minItems": 1,
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "use": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "environment": {
            "type": "string",
            "enum": [
              "interior",
              "outdoor"
            ]
          },
          "floorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "centre": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            },
            "description": "World centre of the space box, not its walking datum. Centre Y = referenced floor top + space height / 2."
          },
          "size": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            }
          },
          "yaw": {
            "type": "number"
          },
          "enclosureIds": {
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            }
          },
          "roofIds": {
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            },
            "description": "Overhead roof or plate anchors; an upper floor plate can shelter a lower space. A composite pavilion is not an explicit roof surface."
          },
          "accessIds": {
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            }
          },
          "stage": {
            "type": "string",
            "enum": [
              "planned-accommodation",
              "allocated-capacity",
              "constructed-space"
            ]
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "id",
          "name",
          "use",
          "environment",
          "floorId",
          "centre",
          "size",
          "yaw",
          "enclosureIds",
          "roofIds",
          "accessIds",
          "stage",
          "limitation"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "minItems": 1,
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "via": {
            "minItems": 1,
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "from",
          "to",
          "via",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "relation": {
            "type": "string",
            "enum": [
              "adjacent-to",
              "connected-to",
              "above",
              "below",
              "facing",
              "set-back-from",
              "covering",
              "clear-of",
              "inside"
            ]
          },
          "clearance": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "subject",
          "target",
          "relation",
          "clearance",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "roofAndSection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "facadeAndClimate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "landscapeAndOutdoorLiving": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "limitations": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    }
  },
  "required": [
    "version",
    "concept",
    "alternatives",
    "selectionReason",
    "site",
    "anchors",
    "spaces",
    "routes",
    "relationships",
    "roofAndSection",
    "facadeAndClimate",
    "landscapeAndOutdoorLiving",
    "limitations"
  ],
  "additionalProperties": false
}
