        ],
        "limitation": "No shoreline, surveyed flood datum, coastal setback, public access route or marine work is modelled."
      },
      {
        "disposition": "constructed",
        "knowledgeId": "contemporary-rustic",
        "decision": "Balanced ivory enclosure with limestone planes, timber outdoor supports and bronze accents for a warm contemporary tropical character.",
        "elementIds": [
