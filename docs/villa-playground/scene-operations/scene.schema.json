{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "architectural-scene-1"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "elements": {
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "label": {
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "plate",
              "wall",
              "roof",
              "glazing",
              "balcony",
              "entrance",
              "screen",
              "sofa",
              "volume",
              "water"
            ]
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "at": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "default": 0,
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "size": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 60
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 60
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "material": {
            "default": "ivory",
            "type": "string",
            "enum": [
              "ivory",
              "limestone",
              "timber",
              "bronze",
              "sage"
            ]
          },
          "panels": {
            "default": 4,
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "opening": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "sill": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 40
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 20
              },
              "glazed": {
                "type": "boolean"
              }
            },
            "required": [
              "x",
              "sill",
              "width",
              "height",
              "glazed"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "at",
          "rotation",
          "size",
          "material",
          "panels"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "name",
    "elements"
  ],
  "additionalProperties": false
}