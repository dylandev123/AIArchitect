# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI usage log
.data/

# Private, bounded development-only V3 failure fixtures
/.v3-debug/

# Staged-generation evidence: large regenerable artefacts and uncurated captures
# (curated screenshots are added explicitly with `git add -f`; see docs/architecture/PRESERVATION-PLAN.md)
docs/architecture/**/comparison.html
docs/architecture/staged-villa/stage6-refinement/review-request-*/wire-request.json
docs/architecture/**/*.png
docs/architecture/**/*.jpg
